OPENQR_BIND_ADDRESS=127.0.0.1
OPENQR_PORT=8000
OPENQR_RELAYS=wss://relay.openetr.org
OPENQR_QUERY_TIMEOUT_SECONDS=10
OPENQR_QUERY_LIMIT=20
OPENQR_PUBLIC_BASE_URL=
OPENQR_MAX_UPLOAD_BYTES=26214400
OPENQR_BLOSSOM_SERVER=https://blossom.getsafebox.app
# Upload pool; defaults to the single-server setting above.
OPENQR_BLOSSOM_SERVERS=
# Additional retrieval candidates; combined with anchor hints and upload servers.
OPENQR_BLOSSOM_QUERY_SERVERS=
OPENQR_BLOSSOM_REQUIRE=any
OPENQR_BLOSSOM_OPERATION_TIMEOUT_SECONDS=60
OPENQR_BLOSSOM_NSEC=
OPENQR_SIGNER_NSEC=
OPENQR_BLOSSOM_TIMEOUT_SECONDS=20
# Existing OpenETR Control Desk configuration is discovered on these relays.
OPENQR_HOME_RELAYS=wss://relay.openetr.org
OPENQR_REGISTRATION_MODE=interactive
# Generate using: openssl rand -hex 32
OPENQR_SESSION_SECRET=
OPENQR_SESSION_SECURE=true
